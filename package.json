{
  "name": "oratoria-backend",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.3.6",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.13",
      "better-auth": "^1.6.9"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @oratoria-backend/db db:push",
    "db:studio": "turbo -F @oratoria-backend/db db:studio",
    "db:generate": "turbo -F @oratoria-backend/db db:generate",
    "db:migrate": "turbo -F @oratoria-backend/db db:migrate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@oratoria-backend/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@oratoria-backend/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.9.6",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.12"
}
