    "@oratoria-backend/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.12.15",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oratoria-backend/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.1.0",
    "tsdown": "^0.21.10",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
