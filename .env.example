# Copia este archivo a .env y completa los valores.
# Convención: las variables marcadas con `# TODO: agregar` se configuran
# cuando se trabaje en la épica que las necesita (ver TODO.md). El backend
# arranca sin ellas; solo fallarán los flujos que las usen explícitamente.
# Nota: en archivos .env los comentarios deben ir en su propia línea —
# un `#` después del `=` se interpreta como parte del valor.

# Runtime
ENVIRONMENT=development
DEBUG=true
# Generar con: openssl rand -hex 32
SECRET_KEY=change-me

# Database (apunta al servicio postgres del docker-compose)
DATABASE_URL=postgresql+asyncpg://oratoria:oratoria@localhost:5432/oratoria

# Redis / Celery (apunta al servicio redis del docker-compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
# Generar con: openssl rand -hex 32
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# LLM providers
# TODO: agregar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# TODO: agregar
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# STT / TTS
WHISPER_MODEL=whisper-1
# TODO: agregar
ELEVENLABS_API_KEY=
# TODO: agregar
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Tavus CVI (avatar audience — épica 10)
# TODO: agregar
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
TAVUS_API_BASE_URL=https://tavusapi.com/v2
# Generar con: openssl rand -hex 32; debe coincidir con el secret configurado
# en el dashboard de Tavus para firmar webhooks
TAVUS_WEBHOOK_SECRET=
TAVUS_MAX_CALL_DURATION_SECONDS=900
# Base URL pública del backend (para que Tavus alcance /webhooks/tavus)
# en local, deja vacío o usa ngrok/cloudflared
TAVUS_CALLBACK_BASE_URL=

# Cloudflare R2
# TODO: agregar
R2_ACCOUNT_ID=
# TODO: agregar
R2_ACCESS_KEY_ID=
# TODO: agregar
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oratoria
# TODO: agregar
R2_ENDPOINT_URL=

# Payments
# TODO: agregar
STRIPE_SECRET_KEY=
# TODO: agregar
STRIPE_WEBHOOK_SECRET=
# TODO: agregar
STRIPE_PRICE_BASIC=
# TODO: agregar
STRIPE_PRICE_PRO=
# TODO: agregar
CULQI_PUBLIC_KEY=
# TODO: agregar
CULQI_SECRET_KEY=

# Email
# TODO: agregar
RESEND_API_KEY=
RESEND_FROM=no-reply@oratoria.app

# Observability
# TODO: agregar
SENTRY_DSN=
# TODO: agregar
LANGFUSE_PUBLIC_KEY=
# TODO: agregar
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
